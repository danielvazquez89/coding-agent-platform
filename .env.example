# Compose deployment settings. Copy to `.env`, replace both secrets, and keep `.env` out of Git.
# These values target the containerized worker; local `quarkus:dev` uses the defaults in
# `src/main/resources/application.properties` (for example, OLLAMA_BASE_URL defaults to localhost).
# An empty environment variable is treated as unset; optional features also accept the `disabled` sentinel.
DB_PASSWORD=replace-with-a-long-random-database-password
AGENT_CONTROL_PLANE_TOKEN=replace-with-at-least-32-random-bytes
# Model provider: `ollama` (default) or `openai-compatible`. Only the selected one is exercised.
AGENT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local models sometimes emit malformed tool-call JSON, which Ollama answers with HTTP 500
# (`error parsing tool call`); a fresh sample usually decodes. Retries are bounded.
OLLAMA_RETRY_MAX_ATTEMPTS=5
OLLAMA_RETRY_INITIAL_BACKOFF_MILLIS=1000
OLLAMA_RETRY_MAX_BACKOFF_MILLIS=60000
# Used only when AGENT_MODEL_PROVIDER=openai-compatible. The base URL includes the version segment,
# for example https://api.openai.com/v1. Leave the key empty for a local server that needs no auth.
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_MODEL=
AGENT_OPENAI_API_KEY=
# `apply_patch` accepts a git unified diff or the Codex `*** Begin Patch` envelope; see the model
# provider section of README.md before choosing a hosted model.
# Transient failures (HTTP 429/5xx) are retried with exponential backoff and jitter; these are the defaults.
AGENT_OPENAI_RETRY_MAX_ATTEMPTS=5
AGENT_OPENAI_RETRY_INITIAL_BACKOFF_MILLIS=1000
AGENT_OPENAI_RETRY_MAX_BACKOFF_MILLIS=60000
# Shared one-minute pacing budget for the OpenAI-compatible provider. Set the provider's published
# cap (for example 8000 tokens per minute on Groq's free tier); `disabled` turns pacing off. A turn
# waits at most the maximum wait and is then sent anyway, so retry/backoff remains the final defence.
AGENT_RATE_LIMIT_REQUESTS_PER_MINUTE=disabled
AGENT_RATE_LIMIT_TOKENS_PER_MINUTE=disabled
AGENT_RATE_LIMIT_MAX_WAIT_MILLIS=60000
# Characters of tool history one request may carry; the system and task prompts are bounded separately
# and are not counted against it. Keep the working set a task needs inside this, and prompt plus history
# under the provider's per-request limit (the rate-limit budget above is in tokens, at roughly four
# characters per token). `disabled` keeps the full history.
AGENT_MAX_HISTORY_CHARACTERS=24000
AGENT_GITHUB_PULL_REQUESTS_ENABLED=false
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_ALLOWED_REPOSITORIES=
# Repository map prepended to the prompt: BM25 + PageRank over identifiers, packed into a token
# budget (characters / 4). Set AGENT_REPO_MAP_ENABLED=false to omit it.
AGENT_REPO_MAP_ENABLED=true
AGENT_REPO_MAP_MAX_TOKENS=800
AGENT_REPO_MAP_MAX_ENTRIES=12
AGENT_REPO_MAP_MAX_INDEXED_FILES=4000
AGENT_REPO_MAP_MAX_FILE_BYTES=262144
