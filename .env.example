# Compose deployment settings. Copy to `.env`, replace both secrets, and keep `.env` out of Git.
# These values target the containerized worker; local `quarkus:dev` uses the defaults in
# `src/main/resources/application.properties` (for example, OLLAMA_BASE_URL defaults to localhost).
# An empty environment variable is treated as unset; optional features also accept the `disabled` sentinel.
DB_PASSWORD=replace-with-a-long-random-database-password
AGENT_CONTROL_PLANE_TOKEN=replace-with-at-least-32-random-bytes
OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_GITHUB_PULL_REQUESTS_ENABLED=false
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_ALLOWED_REPOSITORIES=
